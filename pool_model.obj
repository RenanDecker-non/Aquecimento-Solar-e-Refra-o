# pool_model.obj
# Estrutura básica de uma piscina retangular para visualização
# Vértices (x, y, z)
v -3.0 -0.5 -2.0
v  3.0 -0.5 -2.0
v  3.0 -0.5  2.0
v -3.0 -0.5  2.0
v -3.0  0.5 -2.0
v  3.0  0.5 -2.0
v  3.0  0.5  2.0
v -3.0  0.5  2.0

# Normais
vn 0.0 -1.0 0.0
vn 0.0  1.0 0.0
vn 0.0  0.0 -1.0
vn 0.0  0.0  1.0
vn -1.0 0.0  0.0
vn  1.0 0.0  0.0

# Faces (Formato: v/vt/vn)
f 1//1 2//1 3//1 4//1
f 5//2 8//2 7//2 6//2
f 1//5 5//5 6//5 2//5
f 2//6 6//6 7//6 3//6
f 3//4 7//4 8//4 4//4
f 5//3 1//3 4//3 8//3
